/*
 * Shared printf core template.
 *
 * One core implementation is generated by:
 * 1. selecting a profile via macros in the including .c file
 * 2. resolving capability macros in printf_profile.h
 * 3. assembling the parser/text/int/float helper graph
 * 4. emitting one concrete core symbol
 */

#include "printf_core_private.h"

#include "support/ultoa_invert.c"

#if PRINTF_CAP_POSITIONAL
#include "parse/_printf_positional.c"
#endif
#include "text/_printf_text_core.c"
#include "parse/_printf_parser.c"
#include "int/_printf_int_dec.c"
#include "int/_printf_int_base.c"
#include "text/_printf_c.c"
#include "text/_printf_s.c"
#include "text/_printf_n.c"
#include "int/_printf_d.c"
#include "int/_printf_u.c"
#include "int/_printf_o.c"
#include "int/_printf_x.c"
#if PRINTF_CAP_BINARY
#include "int/_printf_b.c"
#endif
#include "parse/_printf_conversion_dispatch.c"

#if IO_VARIANT_IS_FLOAT(PRINTF_CORE_PROFILE)
#include "float/printf_float.h"
#endif

int
PRINTF_CORE_SYMBOL(struct __printf_out *out, const CHAR *fmt, va_list ap_orig)
{
    unsigned c;
    struct __printf_spec spec;
    struct __printf_runtime_bundle {
        struct __printf_core_runtime io;
#if IO_VARIANT_IS_FLOAT(PRINTF_CORE_PROFILE)
        struct dtoa dtoa;
#endif
    };
    struct __printf_runtime_bundle runtime;
    struct __printf_core_context core_ctx;

    __printf_core_context_init(&core_ctx, &runtime.io, fmt);
    core_ctx.msg = __printf_validate_core_inputs(out, fmt);

    if (core_ctx.msg != NULL)
        return __printf_handle_core_error(out, core_ctx.msg);

    if (__printf_out_begin(out) < 0)
        return EOF;

    __printf_positional_init(&core_ctx, ap_orig);

    for (;;) {
        int literal_status = __printf_parse_scan_literal(out, &core_ctx.stream_len, &fmt, &c);

        switch (literal_status) {
        case -1:
            goto fail;
        case 0:
            goto ret;
        default:
            break;
        }

        if (__printf_parse_conversion_spec(&spec, &c, &fmt, &core_ctx, ap_orig)
            == __PRINTF_PARSE_SPEC_DONE)
            goto ret;

        {
            int dispatch_status;

            dispatch_status = __printf_dispatch_conversion(out, &core_ctx.stream_len, &spec.flags,
                                                           &spec.prec, &spec.width, c,
#if PRINTF_CAP_POSITIONAL
                                                           core_ctx.positional.ap,
#else
                                                           ap_orig,
#endif
                                                           &core_ctx.text
#if IO_VARIANT_IS_FLOAT(PRINTF_CORE_PROFILE)
                                                           ,
                                                           &runtime.dtoa
#endif
                                                           ,
                                                           &core_ctx.msg);

            if (dispatch_status == __PRINTF_DISPATCH_ERROR)
                goto fail;
            if (dispatch_status == __PRINTF_DISPATCH_SECURE_FAIL)
                goto handle_error;
            if (dispatch_status == __PRINTF_DISPATCH_SKIP_TAIL)
                continue;
        }

        if (!__printf_cap_shrink_enabled()
            && __printf_emit_width_tail(out, &core_ctx.stream_len, &spec.width) < 0)
            goto fail;
    }

ret:
    __printf_positional_cleanup(&core_ctx);
    return __printf_out_finish(out, core_ctx.stream_len);

fail:
    __printf_positional_cleanup(&core_ctx);
    return __printf_out_finish_failed(out);

handle_error:
    __printf_positional_cleanup(&core_ctx);
    return __printf_handle_core_error(out, core_ctx.msg);
}
